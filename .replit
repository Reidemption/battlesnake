run = ["make", "run"]

# If the main file is changed, also change it in Makefile.
entrypoint = "main.go"
hidden = ["Makefile", "main"]

[languages.go]
pattern = "**/*.go"

[languages.go.languageServer]
start = "gopls"

[nix]
channel = "stable-21_11"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
deploymentTarget = "cloudrun"
build = ["go", "build", "-o", "battlesnake", "."]
run = ["./battlesnake"]

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 18000
externalPort = 3000
